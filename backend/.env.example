# Backend Configuration
PROJECT_NAME="PatentGraph AI - Indian Patent Intelligence"
VERSION="1.0.0"
ENVIRONMENT="development"
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# MongoDB Configuration
MONGODB_URI="mongodb://localhost:27017"
MONGODB_DB_NAME="patentgraph_db"
MONGODB_COLLECTION="patents"

# Neo4j Graph Database Configuration
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="password"

# Vector Search & Embeddings
EMBEDDING_MODEL_NAME="all-MiniLM-L6-v2"
EMBEDDING_DIM=384
FAISS_INDEX_PATH="backend/app/data/faiss_index.bin"
FAISS_ID_MAP_PATH="backend/app/data/faiss_id_map.json"
BM25_INDEX_PATH="backend/app/data/bm25_index.pkl"
GRAPH_STORE_PATH="backend/app/data/knowledge_graph.pkl"
CLEANED_DATA_PATH="backend/app/data/cleaned_patents.parquet"

# LLM Providers (Configure at least one for RAG response synthesis)
# Supported: gemini, openai, local, mock
LLM_PROVIDER="gemini"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# RAG Settings
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.3
RAG_MAX_CONTEXT_TOKENS=2000
