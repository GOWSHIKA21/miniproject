# PatentGraph AI - Cloud Services Configuration Template
# ==============================================================================
# Copy this file to '.env' inside 'miniproject/backend/'
# Never commit actual credentials to Git!
# ==============================================================================

# 1. MongoDB Atlas (Patent Documents & Metadata - Preserved)
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority"
MONGODB_DATABASE="patentgraph_db"
MONGODB_COLLECTION="patents"

# 2. Neo4j Aura (Knowledge Graph)
# Official Aura URI format: neo4j+s://<dbid>.databases.neo4j.io
# NOTE: Make sure your Aura Free instance is RESUMED (Active) in https://console.neo4j.io
NEO4J_URI="neo4j+s://<dbid>.databases.neo4j.io"
NEO4J_USERNAME="neo4j"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="<your-aura-password>"
NEO4J_DATABASE="neo4j"

# 3. Qdrant Cloud (Vector Similarity Search)
# Qdrant Cloud endpoint URL (HTTPS port 443; do NOT add :6333 for cloud clusters)
# Format: https://<cluster-id>.<region>.aws.cloud.qdrant.io
QDRANT_URL="https://<cluster-id>.<region>.aws.cloud.qdrant.io"
# Your secret Qdrant Cloud API Key generated in Qdrant Console -> Cluster -> API Keys
# (IMPORTANT: Do NOT paste the cluster URL here! Paste the secret token string)
QDRANT_API_KEY="<your-secret-qdrant-api-key-token>"
QDRANT_COLLECTION="patent_embeddings"

# Migration Batching Configuration
MIGRATION_BATCH_SIZE=2000
